# JV Baiak - etapa FINAL do cliente web (roda na VPS, leva poucos minutos):
# parte da base pre-compilada e junta o que e so nosso: dominio da ponte WebSocket,
# tela de login do nosso servidor, sprites 8.60, ajustes para celular (tela nitida,
# toque) e a pagina do jogo. Refaz so o que mudou (poucos arquivos + o link).
ARG BASE_IMG=jvbaiak/web-base:local
FROM ${BASE_IMG} AS builder
SHELL ["/bin/bash", "-lc"]
COPY jv_web_config.h /workspace/src/framework/net/jv_web_config.h
COPY init.lua /workspace/init.lua
COPY Tibia.dat Tibia.spr /workspace/data/things/860/
COPY jv/ /tmp/jv/
RUN cd /workspace \
 && for p in /tmp/jv/patches/*.patch; do \
      [ -f "$p" ] || continue; \
      git apply --whitespace=nowarn "$p" || { echo "patch $p nao aplicou"; exit 1; }; \
    done \
 && cp /tmp/jv/shell.html browser/shell.html \
 && cat /tmp/jv/otclientrc-extra.lua >> otclientrc.lua \
 && if [ -f /tmp/jv/fundo-login.png ]; then cp /tmp/jv/fundo-login.png data/images/background.png; fi \
 && if [ -d /tmp/jv/imagens ]; then cp /tmp/jv/imagens/*.png data/images/options/; fi \
 && source /opt/emsdk/emsdk_env.sh \
 && touch /workspace/src/framework/net/jv_web_config.h \
 && rm -f ${BUILD_DIR}/bin/otclient.* \
 && cmake --build ${BUILD_DIR} --target otclient -j"$(nproc)" \
 && test -f ${BUILD_DIR}/bin/otclient.wasm

FROM busybox:latest
WORKDIR /otclient-web
COPY --from=builder /workspace/build-emscripten/bin/ .
CMD ["sh"]
