+    // IDs do cliente 8.60: somente efeitos de fogo/veneno conhecidos do items.otb.
+    bool jvCampoTransponivel(uint32_t id)
+    {
+        switch (id) {
+            case 105: case 2118: case 2119: case 2120: case 2121:
+            case 2123: case 2124: case 2125: case 2131: case 2132:
+            case 2133: case 10069: case 10070: case 10071: return true;
+            default: return false;
+        }
+    }
+
+    bool jvCaminhoComCampo(const TilePtr& tile)
+    {
+        bool campo = false;
+        for (const auto& thing : tile->getThings()) {
+            if (thing->isNotPathable()) {
+                if (!thing->isItem() || !jvCampoTransponivel(thing->getId())) return false;
+                campo = true;
+            }
+        }
+        return campo;
+    }
