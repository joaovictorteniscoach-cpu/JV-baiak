diff --git a/src/client/protocolgamesend.cpp b/src/client/protocolgamesend.cpp
index d206e97..c3d5639 100644
--- a/src/client/protocolgamesend.cpp
+++ b/src/client/protocolgamesend.cpp
@@ -28,6 +28,7 @@
 #include "thingtypemanager.h"
 #include "thingtype.h"
 #include "framework/util/crypt.h"
+#include "framework/stdext/string.h"
 
 #ifndef USE_PRECOMPILED_HEADERS
 #include <algorithm>
@@ -582,7 +583,15 @@ void ProtocolGame::sendTalk(const Otc::MessageMode mode, const uint16_t channelI
             break;
     }
 
-    msg->addString(message);
+    // JV Baiak: o servidor 8.60 le latin-1; o que voce digita (UTF-8) vai em latin-1, para os
+    // NPCs entenderem palavras com acento e os outros jogadores lerem certo.
+    const std::string texto(message);
+    if (stdext::is_valid_utf8(texto)) {
+        const std::string latin = stdext::utf8_to_latin1(texto);
+        msg->addString(latin.empty() ? texto : latin);
+    } else {
+        msg->addString(texto);
+    }
     send(msg);
 }
 
