#!/usr/bin/env bash
# JV Baiak - administracao do servidor. Rode "jvbaiak ajuda".
set -Eeuo pipefail

BASE="${BASE:-/opt/jvbaiak}"
ENV="$BASE/.env"
BACKUPS="$BASE/backups"
MANTER_BACKUPS="${MANTER_BACKUPS:-14}"

falha() { printf '\033[1;31mERRO:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1;32m%s\033[0m\n' "$*"; }

[ "$(id -u)" -eq 0 ] || falha "rode como root (sudo jvbaiak ...)"
[ -f "$ENV" ] || falha "instalacao nao encontrada em $BASE"
cd "$BASE"

le_env() { grep -E "^$1=" "$ENV" 2>/dev/null | tail -n1 | cut -d= -f2- || true; }
define_env() { # chave valor
	local tmp
	tmp="$(mktemp)"
	grep -vE "^$1=" "$ENV" > "$tmp" || true
	printf '%s=%s\n' "$1" "$2" >> "$tmp"
	install -m 600 "$tmp" "$ENV"
	rm -f "$tmp"
}
dc() { docker compose "$@"; }

# Executa SQL no banco do jogo (sem expor a senha na linha de comando)
# (a senha vem do proprio container do banco: nunca aparece na lista de processos)
sql() {
	dc exec -T db sh -c 'MYSQL_PWD="$MARIADB_PASSWORD" exec mariadb -ujvbaiak jvbaiak --batch --skip-column-names "$@"' sh "$@"
}
sql_root() {
	dc exec -T db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec "$@"' sh "$@"
}
esc() { printf '%s' "$1" | sed "s/\\\\/\\\\\\\\/g; s/'/\\\\'/g"; }  # escapa para string SQL
sha1() { printf '%s' "$1" | sha1sum | awk '{print $1}'; }

reinicia_servidor() {
	info "Reiniciando o servidor do jogo (os jogadores sao salvos antes)..."
	dc restart servidor
}

lua_define() { # chave valor_lua
	local cfg="$BASE/servidor/config.lua"
	LC_ALL=C awk -v k="$1" -v v="$2" '
		BEGIN { feito = 0 }
		$0 ~ "^" k "[ \t]*=" { print k " = " v; feito = 1; next }
		{ print }
		END { if (!feito) print k " = " v }
	' "$cfg" > "$cfg.tmp" && cat "$cfg.tmp" > "$cfg" && rm -f "$cfg.tmp"
}

cmd_status() {
	dc ps
	echo
	local online
	online="$(sql -e 'SELECT COUNT(*) FROM players_online' 2>/dev/null || echo '?')"
	info "Jogadores online: $online"
	echo "Site: http://$(le_env ENDERECO_SERVIDOR)"
	free -h | awk 'NR<=2'
	df -h / | awk 'NR==2 {print "Disco: " $3 " usados de " $2 " (" $5 ")"}'
}

cmd_online() {
	sql -e "SELECT p.name, p.level FROM players p JOIN players_online o ON o.player_id = p.id ORDER BY p.level DESC" \
		| awk -F'\t' 'BEGIN {n=0} {printf "%-25s level %s\n", $1, $2; n++} END {if (n==0) print "Ninguem online."}'
}

cmd_logs() { dc logs -f --tail 200 "${1:-servidor}"; }
cmd_reiniciar() { if [ -n "${1:-}" ]; then dc restart "$1"; else dc restart servidor portal; fi; }
cmd_parar() { dc stop servidor portal; info "Servidor e site parados (o banco continua ligado)."; }
cmd_iniciar() { dc up -d db servidor portal; }

cmd_backup() {
	mkdir -p "$BACKUPS"
	chmod 700 "$BACKUPS"
	local data arq
	data="$(date +%Y%m%d-%H%M)"
	arq="$BACKUPS/banco-$data.sql.gz"
	sql_root mariadb-dump -uroot --single-transaction --routines --triggers jvbaiak | gzip -9 > "$arq.tmp"
	[ -s "$arq.tmp" ] || { rm -f "$arq.tmp"; falha "backup do banco saiu vazio"; }
	mv "$arq.tmp" "$arq"
	tar -czf "$BACKUPS/dados-$data.tar.gz" --exclude='servidor/data/logs' servidor .env clientes-cache/apk-assinatura.jks 2>/dev/null \
		|| tar -czf "$BACKUPS/dados-$data.tar.gz" --exclude='servidor/data/logs' servidor .env
	chmod 600 "$BACKUPS"/*
	# guarda so os mais recentes
	ls -1t "$BACKUPS"/banco-*.sql.gz 2>/dev/null | tail -n +"$((MANTER_BACKUPS + 1))" | xargs -r rm -f
	ls -1t "$BACKUPS"/dados-*.tar.gz 2>/dev/null | tail -n +"$((MANTER_BACKUPS + 1))" | xargs -r rm -f
	info "Backup salvo: $arq"
}

cmd_restaurar() {
	local arq="${1:-}"
	[ -f "$arq" ] || falha "informe o arquivo: jvbaiak restaurar $BACKUPS/banco-AAAAMMDD-HHMM.sql.gz"
	read -r -p "Isso SUBSTITUI todas as contas e personagens atuais pelo backup. Digite RESTAURAR para continuar: " resp
	[ "$resp" = "RESTAURAR" ] || falha "cancelado"
	cmd_backup
	dc stop servidor
	gunzip -c "$arq" | sql_root mariadb -uroot jvbaiak
	dc start servidor
	info "Banco restaurado de $arq"
}

cmd_criar_gm() { # conta senha personagem
	local conta="${1:-}" senha="${2:-}" nome="${3:-}"
	[[ "$conta" =~ ^[a-z0-9]{4,20}$ ]] || falha "uso: jvbaiak criar-gm <conta> <senha> <Nome do Personagem>"
	[ "${#senha}" -ge 6 ] || falha "senha com pelo menos 6 caracteres"
	[[ "$nome" =~ ^[A-Za-z\ ]{3,25}$ ]] || falha "nome do personagem: 3-25 letras e espacos"
	criar_gm_hash "$conta" "$(sha1 "$senha")" "$nome"
	info "GM pronto: conta '$conta', personagem '$nome'."
}

criar_gm_hash() { # conta sha1-da-senha personagem
	sql <<-SQL
		INSERT INTO accounts (name, password, type, premdays, email, creation)
		  VALUES ('$(esc "$1")', '$(esc "$2")', 5, 0, '', UNIX_TIMESTAMP())
		  ON DUPLICATE KEY UPDATE password = VALUES(password), type = 5;
		SET @conta = (SELECT id FROM accounts WHERE name = '$(esc "$1")');
		INSERT INTO players (name, group_id, account_id, level, vocation, health, healthmax, experience,
		  lookbody, lookfeet, lookhead, looklegs, looktype, mana, manamax, town_id, conditions, cap, sex)
		  VALUES ('$(esc "$3")', 5, @conta, 8, 0, 185, 185, 4200, 68, 76, 78, 58, 75, 35, 35, 1, '', 470, 1)
		  ON DUPLICATE KEY UPDATE group_id = 5, account_id = @conta;
	SQL
}

cmd_admins_kit() { # aplica servidor-imagem/contas-admin.txt (conta_antiga;conta;sha1;Personagem)
	local arq="$BASE/servidor-imagem/contas-admin.txt" antiga conta hash nome id_alvo id_antiga tipo id_gm
	[ -f "$arq" ] || return 0
	while IFS=';' read -r antiga conta hash nome; do
		case "$antiga" in \#*) continue ;; esac
		[[ "$conta" =~ ^[a-z0-9]{4,20}$ ]] && [[ "$hash" =~ ^[0-9a-f]{40}$ ]] && [[ "$nome" =~ ^[A-Za-z\ ]{3,25}$ ]] || continue
		id_alvo="$(sql -e "SELECT id FROM accounts WHERE name = '$(esc "$conta")'" </dev/null)"
		id_antiga=""
		[ -n "$antiga" ] && id_antiga="$(sql -e "SELECT id FROM accounts WHERE name = '$(esc "$antiga")'" </dev/null)"
		if [ -n "$id_alvo" ]; then
			tipo="$(sql -e "SELECT type FROM accounts WHERE id = $id_alvo" </dev/null)"
			if [ "${tipo:-0}" -lt 5 ]; then
				printf 'aviso: ja existe uma conta comum chamada %s; nao mexi nela\n' "$conta" >&2
				continue
			fi
			id_antiga="$id_alvo"
		fi
		# personagem com esse nome em outra conta? usa "Nome Gm"
		if [ -n "$(sql -e "SELECT id FROM players WHERE name = '$(esc "$nome")' AND account_id <> '${id_antiga:-0}'" </dev/null)" ]; then
			nome="$nome Gm"
		fi
		if [ -n "$id_antiga" ]; then
			sql -e "UPDATE accounts SET name = '$(esc "$conta")', password = '$hash', type = 5 WHERE id = $id_antiga" </dev/null
			id_gm="$(sql -e "SELECT id FROM players WHERE account_id = $id_antiga ORDER BY group_id DESC, id LIMIT 1" </dev/null)"
			if [ -n "$id_gm" ]; then
				sql -e "UPDATE players SET name = '$(esc "$nome")', group_id = 5 WHERE id = $id_gm" </dev/null
			else
				criar_gm_hash "$conta" "$hash" "$nome"
			fi
		else
			criar_gm_hash "$conta" "$hash" "$nome"
		fi
		printf 'administrador pronto: conta %s, personagem %s\n' "$conta" "$nome"
		if [ "$antiga" = "admin" ] && [ -f /root/jvbaiak-credenciais.txt ]; then
			sed -i "s/^Conta GM: .*/Conta GM:        $conta/; s/^Senha GM: .*/Senha GM:        (a que o Claude passou na conversa)/; s/^Personagem GM: .*/Personagem GM:   $nome/" \
				/root/jvbaiak-credenciais.txt
		fi
	done < "$arq"
}

cmd_reparar_banco() { # cria tabelas que o Baiak Thunder usa mas o schema original nao cria
	# Sem player_inboxitems o servidor NAO SALVA o personagem (level, itens, posicao) ao sair.
	sql <<-'SQL'
		CREATE TABLE IF NOT EXISTS `player_inboxitems` (
		  `player_id` int(11) NOT NULL,
		  `sid` int(11) NOT NULL,
		  `pid` int(11) NOT NULL DEFAULT '0',
		  `itemtype` smallint(6) NOT NULL,
		  `count` smallint(5) NOT NULL DEFAULT '0',
		  `attributes` blob NOT NULL,
		  UNIQUE KEY `player_id_2` (`player_id`, `sid`),
		  FOREIGN KEY (`player_id`) REFERENCES `players`(`id`) ON DELETE CASCADE
		) ENGINE=InnoDB DEFAULT CHARACTER SET=utf8;
		CREATE TABLE IF NOT EXISTS `account_storage` (
		  `account_id` int(11) NOT NULL,
		  `key` int(10) unsigned NOT NULL,
		  `value` int(11) NOT NULL,
		  PRIMARY KEY (`account_id`, `key`),
		  FOREIGN KEY (`account_id`) REFERENCES `accounts`(`id`) ON DELETE CASCADE
		) ENGINE=InnoDB DEFAULT CHARACTER SET=utf8;
		CREATE TABLE IF NOT EXISTS `znote_guild_wars` (
		  `id` int(11) NOT NULL AUTO_INCREMENT,
		  `limit` int(11) NOT NULL DEFAULT '20',
		  PRIMARY KEY (`id`)
		) ENGINE=InnoDB DEFAULT CHARACTER SET=utf8;
	SQL
	info "Banco conferido: tabelas de salvar personagem ok."
}

cmd_admin() { # interativo: cria ou renomeia uma conta de administrador (tudo liberado)
	[ -t 0 ] || falha "rode no terminal: sudo jvbaiak admin"
	sqlq() { sql "$@" </dev/null; }  # o banco nao le o que voce digita
	echo
	info "Contas de administrador que existem hoje:"
	sqlq -e "SELECT CONCAT('  conta: ', a.name, '   personagens: ', IFNULL(GROUP_CONCAT(p.name SEPARATOR ', '), '-'))
	        FROM accounts a LEFT JOIN players p ON p.account_id = a.id
	        WHERE a.type >= 5 GROUP BY a.id ORDER BY a.id"
	echo
	local antiga="" conta senha senha2 nome id_antiga="" id_outra
	read -rp "Trocar uma conta que ja existe? Digite o nome dela (ex.: admin) ou so Enter para criar nova: " antiga
	antiga="$(printf '%s' "$antiga" | tr -d ' ' | tr 'A-Z' 'a-z')"
	if [ -n "$antiga" ]; then
		id_antiga="$(sqlq -e "SELECT id FROM accounts WHERE name = '$(esc "$antiga")'")"
		[ -n "$id_antiga" ] || falha "a conta '$antiga' nao existe"
		[ "$(sqlq -e "SELECT COUNT(*) FROM players_online o JOIN players p ON p.id = o.player_id WHERE p.account_id = $id_antiga")" = "0" ] \
			|| falha "saia do jogo com os personagens da conta '$antiga' e rode de novo"
	fi
	read -rp "Nome NOVO da conta (login: 4 a 20 letras minusculas ou numeros): " conta
	conta="$(printf '%s' "$conta" | tr -d ' ' | tr 'A-Z' 'a-z')"
	[[ "$conta" =~ ^[a-z0-9]{4,20}$ ]] || falha "nome da conta: 4 a 20 letras minusculas ou numeros, sem espaco"
	id_outra="$(sqlq -e "SELECT id FROM accounts WHERE name = '$(esc "$conta")'")"
	if [ -n "$id_outra" ] && [ "$id_outra" != "$id_antiga" ]; then
		falha "ja existe uma conta chamada '$conta'"
	fi
	read -rsp "Senha (6+ caracteres; nao aparece enquanto digita): " senha; echo
	read -rsp "Repita a senha: " senha2; echo
	[ "$senha" = "$senha2" ] || falha "as senhas nao sao iguais"
	[ "${#senha}" -ge 6 ] || falha "senha com pelo menos 6 caracteres"
	read -rp "Nome do personagem (ex.: Joao Victor): " nome
	[[ "$nome" =~ ^[A-Za-z\ ]{3,25}$ ]] || falha "nome do personagem: 3 a 25 letras e espacos (sem acento)"
	if [ -n "$(sqlq -e "SELECT id FROM players WHERE name = '$(esc "$nome")' AND account_id <> '${id_antiga:-0}'")" ]; then
		falha "ja existe um personagem chamado '$nome'"
	fi
	if [ -n "$id_antiga" ]; then
		local id_gm
		sqlq -e "UPDATE accounts SET name = '$(esc "$conta")', password = '$(sha1 "$senha")', type = 5 WHERE id = $id_antiga"
		id_gm="$(sqlq -e "SELECT id FROM players WHERE account_id = $id_antiga ORDER BY group_id DESC, id LIMIT 1")"
		if [ -n "$id_gm" ]; then
			sqlq -e "UPDATE players SET name = '$(esc "$nome")', group_id = 5 WHERE id = $id_gm"
		else
			cmd_criar_gm "$conta" "$senha" "$nome" >/dev/null
		fi
	else
		cmd_criar_gm "$conta" "$senha" "$nome" >/dev/null
	fi
	if [ -f /root/jvbaiak-credenciais.txt ] && [ -n "$antiga" ]; then
		sed -i "s/^Conta GM: .*/Conta GM:        $conta/; s/^Senha GM: .*/Senha GM:        (a que voce escolheu)/; s/^Personagem GM: .*/Personagem GM:   $nome/" \
			/root/jvbaiak-credenciais.txt
	fi
	echo
	info "Pronto! Administrador com tudo liberado:"
	info "  conta: $conta    personagem: $nome"
	info "  No jogo, fale /comandos para ver a lista (criar item, clonar, teletransportar...)."
}

cmd_gm() { # personagem
	local nome="${1:-}"
	[ -n "$nome" ] || falha "uso: jvbaiak gm \"Nome do Personagem\""
	local n
	n="$(sql -e "UPDATE players SET group_id = 5 WHERE name = '$(esc "$nome")'; SELECT ROW_COUNT();")"
	[ "$n" = "1" ] || falha "personagem '$nome' nao encontrado"
	sql -e "UPDATE accounts SET type = 5 WHERE id = (SELECT account_id FROM players WHERE name = '$(esc "$nome")')"
	info "'$nome' agora e GM. Ele precisa relogar."
}

cmd_senha() { # conta nova_senha
	local conta="${1:-}" senha="${2:-}"
	[ -n "$conta" ] && [ "${#senha}" -ge 6 ] || falha "uso: jvbaiak senha <conta> <nova-senha (6+ caracteres)>"
	local n
	n="$(sql -e "UPDATE accounts SET password = '$(sha1 "$senha")' WHERE name = '$(esc "$conta")'; SELECT ROW_COUNT();")"
	[ "$n" = "1" ] || falha "conta '$conta' nao encontrada (ou a senha ja era essa)"
	info "Senha da conta '$conta' alterada."
}

cmd_clientes() {
	info "Gerando os clientes Windows e Android..."
	dc --profile ferramentas build clientes
	dc --profile ferramentas run --rm -T clientes </dev/null
	info "Prontos em http://$(le_env ENDERECO_SERVIDOR)/baixar"
}

cmd_endereco() { # novo ip/dominio
	local novo="${1:-}"
	[[ "$novo" =~ ^[A-Za-z0-9.-]+$ ]] || falha "uso: jvbaiak endereco <ip-ou-dominio>"
	define_env ENDERECO_SERVIDOR "$novo"
	lua_define ip "\"$novo\""
	lua_define url "\"http://$novo\""
	dc up -d portal
	reinicia_servidor
	cmd_clientes
	info "Endereco trocado para $novo. Os jogadores precisam baixar o cliente de novo."
}

ip_publico() {
	local url ip
	for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
		ip="$(curl -4 -fsS --max-time 8 "$url" 2>/dev/null | tr -d '[:space:]' || true)"
		if [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then echo "$ip"; return 0; fi
	done
	return 1
}

# Espera o dominio apontar para o IP (cache de DNS): ate ~5 minutos
espera_dns() { # dominio ip
	local dominio="$1" ip="$2" resolvido="" tentativa
	for tentativa in $(seq 1 20); do
		resolvido="$(getent ahostsv4 "$dominio" 2>/dev/null | awk 'NR==1 {print $1}' || true)"
		if [ "$resolvido" = "$ip" ]; then return 0; fi
		if [ "$tentativa" -eq 1 ]; then info "Esperando $dominio apontar para $ip (ate 5 minutos)..."; fi
		sleep 15
	done
	echo "$dominio aponta para '${resolvido:-nada}', mas esta VPS e $ip." >&2
	return 1
}

# Aponta o dominio do DuckDNS para o IP atual. Se o IP mudou (maquina religada),
# reinicia o servidor do jogo para ele anunciar o IP novo.
cmd_atualizar_ip() { # [dominio]
	local dominio="${1:-$(le_env DOMINIO_DNS)}" token ip antigo
	token="$(le_env DUCKDNS_TOKEN)"
	if [[ "$dominio" != *.duckdns.org ]] || [ -z "$token" ]; then
		echo "Sem dominio DuckDNS configurado: nada a fazer."
		return 0
	fi
	ip="$(ip_publico)" || falha "nao consegui descobrir o IP publico desta VPS"
	antigo="$(le_env IP_ATUAL)"
	info "Apontando $dominio para $ip no DuckDNS..."
	[ "$(curl -fsS --max-time 15 "https://www.duckdns.org/update?domains=${dominio%.duckdns.org}&token=$token&ip=$ip" || true)" = "OK" ] \
		|| falha "o DuckDNS recusou (confira o subdominio e o token em duckdns.org)"
	define_env DOMINIO_DNS "$dominio"
	define_env IP_ATUAL "$ip"
	espera_dns "$dominio" "$ip" || falha "o DNS de $dominio ainda nao atualizou; tente de novo em alguns minutos"
	if [ -n "$antigo" ] && [ "$antigo" != "$ip" ] && dc ps --status running --services 2>/dev/null | grep -qx servidor; then
		info "IP mudou ($antigo -> $ip): reiniciando o servidor do jogo"
		dc restart servidor
	fi
}

# Modo web (EXPERIMENTAL): HTTPS no site + cliente no navegador para iPhone.
cmd_web() { # dominio [token-duckdns]
	local dominio="${1:-}" token="${2:-}"
	[[ "$dominio" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] \
		|| falha "uso: jvbaiak web <dominio> [token-do-duckdns]   ex.: jvbaiak web meubaiak.duckdns.org 1234abcd-..."
	if [ -n "$token" ]; then define_env DUCKDNS_TOKEN "$token"; fi
	if [[ "$dominio" == *.duckdns.org ]] && [ -n "$(le_env DUCKDNS_TOKEN)" ]; then
		cmd_atualizar_ip "$dominio"
	else
		local ip
		ip="$(ip_publico)" || falha "nao consegui descobrir o IP publico desta VPS"
		espera_dns "$dominio" "$ip" || falha "Ajuste o DNS de $dominio para $ip e tente de novo."
	fi

	[ -f "$BASE/clientes-cache/sprites860/Tibia.spr" ] || cmd_clientes
	ufw allow 443/tcp >/dev/null 2>&1 || true
	ufw allow 443/udp >/dev/null 2>&1 || true
	define_env DOMINIO "$dominio"
	define_env COMPOSE_FILE "docker-compose.yml:docker-compose.web.yml"
	mkdir -p "$BASE/web/www"
	[ -d "$BASE/web/www/jogar" ] || cp -a "$BASE/web/www-inicial/jogar" "$BASE/web/www/jogar"

	info "Ligando HTTPS (Caddy) e a ponte WebSocket..."
	dc up -d --build --remove-orphans
	dc restart caddy >/dev/null 2>&1 || true  # le o Caddyfile novo (rotas da ponte)
	info "Site agora em https://$dominio (o certificado sai em 1 ou 2 minutos)."

	if systemctl is-active --quiet jvbaiak-web 2>/dev/null; then
		info "Parando a montagem anterior do cliente web (vai recomecar pelo caminho novo)..."
		systemctl stop jvbaiak-web >/dev/null 2>&1 || true
		docker rm -f jvbaiak-web-tmp >/dev/null 2>&1 || true
	fi
	info "Montando o cliente web em segundo plano (com a base pronta do GitHub: uns 10 a 20 minutos)..."
	systemctl reset-failed jvbaiak-web >/dev/null 2>&1 || true
	systemd-run --unit=jvbaiak-web --description="JV Baiak: compilar cliente web" \
		--setenv=BASE="$BASE" /bin/bash "$BASE/web/compilar-web.sh" "$dominio" >/dev/null
	echo "Acompanhe com: jvbaiak web-status   (pode fechar o terminal)"
	echo "Quando terminar, o iPhone joga em: https://$dominio/jogar/"
}

cmd_web_status() {
	systemctl status jvbaiak-web --no-pager 2>/dev/null | sed -n 1,4p || true
	journalctl -u jvbaiak-web -n 25 --no-pager 2>/dev/null || true
	if [ -f "$BASE/web/www/jogar/otclient.wasm" ]; then
		info "Cliente web pronto: https://$(le_env DOMINIO)/jogar/"
	fi
}

cmd_atualizar() { # baixa a versao nova do kit no GitHub e reinstala (dados, contas e mapa ficam)
	local url="${KIT_INSTALADOR:-https://raw.githubusercontent.com/joaovictorteniscoach-cpu/JV-baiak/main/instalar.sh}"
	info "Fazendo backup antes de atualizar..."
	cmd_backup
	info "Baixando e rodando o instalador novo..."
	curl -fsSL "$url" -o /root/instalar.sh || falha "nao consegui baixar $url"
	bash /root/instalar.sh
}

cmd_google() { # [client-id] [client-secret]  -> liga o "Entrar com Google" no site
	local dom id="${1:-}" seg="${2:-}"
	dom="$(le_env DOMINIO)"
	[ -n "$dom" ] || falha "o Google exige HTTPS: ative antes com  jvbaiak web <dominio>"
	if [ -z "$id" ]; then
		cat <<-EOF
			No Google Cloud (console.cloud.google.com), em APIs e servicos > Credenciais >
			Criar credenciais > ID do cliente OAuth > Aplicativo da Web:
			  Origens JavaScript autorizadas:  https://$dom
			  URIs de redirecionamento:        https://$dom/conta/google/retorno
			Depois cole aqui o ID do cliente e a chave secreta.
		EOF
		read -r -p "ID do cliente: " id
	fi
	id="$(printf '%s' "$id" | tr -d '[:space:]')"
	[[ "$id" =~ ^[0-9]+-[A-Za-z0-9_]+\.apps\.googleusercontent\.com$ ]] || falha "esse ID do cliente nao parece do Google (termina em .apps.googleusercontent.com)"
	if [ -z "$seg" ]; then read -r -s -p "Chave secreta do cliente: " seg; echo; fi
	seg="$(printf '%s' "$seg" | tr -d '[:space:]')"
	[[ "$seg" =~ ^[A-Za-z0-9_-]{10,}$ ]] || falha "chave secreta vazia ou com formato estranho"
	define_env GOOGLE_CLIENT_ID "$id"
	define_env GOOGLE_CLIENT_SECRET "$seg"
	dc up -d portal >/dev/null
	info "Entrar com Google ligado: https://$dom/conta"
}

cmd_config() {
	"${EDITOR:-nano}" "$BASE/servidor/config.lua"
	read -r -p "Reiniciar o servidor agora para aplicar? [s/N] " r
	case "$r" in s | S) reinicia_servidor ;; *) echo "Ok. Aplique depois com: jvbaiak reiniciar servidor" ;; esac
}

cmd_ajuda() {
	cat <<-EOF
		JV Baiak - comandos (rode como root):
		  jvbaiak status                    estado dos servicos, online, memoria e disco
		  jvbaiak online                    quem esta jogando agora
		  jvbaiak logs [servidor|portal|db] acompanha o log (Ctrl+C sai)
		  jvbaiak reiniciar [servico]       reinicia servidor e site (ou so o servico dado)
		  jvbaiak parar | iniciar           desliga / liga servidor e site
		  jvbaiak backup                    backup agora (tambem roda todo dia as 05:30)
		  jvbaiak restaurar <arquivo>       volta o banco para um backup
		  jvbaiak admin                     cria ou renomeia uma conta de administrador (pergunta tudo)
		  jvbaiak gm "Nome"                 transforma um personagem em GM
		  jvbaiak criar-gm conta senha Nome cria/atualiza uma conta GM
		  jvbaiak senha <conta> <nova>      troca a senha de uma conta
		  jvbaiak config                    edita o config.lua (rates, pvp, etc.)
		  jvbaiak clientes                  gera de novo os clientes Windows/Android
		  jvbaiak endereco <ip|dominio>     troca o endereco do servidor
		  jvbaiak web <dominio> [token]     (beta) HTTPS + jogar no navegador/iPhone
		  jvbaiak web-status                acompanha a montagem do cliente web
		  jvbaiak atualizar-ip              aponta o dominio DuckDNS para o IP atual
		  jvbaiak atualizar                 backup + instala a versao nova do GitHub (site, scripts)
		  jvbaiak google                    liga o "Entrar com Google" no site (pede ID e chave)
	EOF
}

acao="${1:-ajuda}"
shift || true
case "$acao" in
	status) cmd_status ;;
	online) cmd_online ;;
	logs | log) cmd_logs "$@" ;;
	reiniciar | restart) cmd_reiniciar "$@" ;;
	parar | stop) cmd_parar ;;
	iniciar | start) cmd_iniciar ;;
	backup) cmd_backup ;;
	restaurar) cmd_restaurar "$@" ;;
	admin) cmd_admin ;;
	reparar-banco) cmd_reparar_banco ;;
	admins-kit) cmd_admins_kit ;;
	criar-gm) cmd_criar_gm "$@" ;;
	gm) cmd_gm "$@" ;;
	senha) cmd_senha "$@" ;;
	clientes) cmd_clientes ;;
	endereco) cmd_endereco "$@" ;;
	config) cmd_config ;;
	web) cmd_web "$@" ;;
	web-status) cmd_web_status ;;
	atualizar-ip) cmd_atualizar_ip "$@" ;;
	atualizar | update) cmd_atualizar ;;
	google) cmd_google "$@" ;;
	ajuda | help | -h | --help) cmd_ajuda ;;
	*) cmd_ajuda; exit 1 ;;
esac
