+// As armas de Ascensao conservam o ID real e os atributos. Somente a imagem
+// enviada ao cliente muda conforme a identidade ja salva em cada instancia.
+uint16_t Item::getClientID() const
+{
+    if (hasAttribute(ITEM_ATTRIBUTE_CUSTOM)) {
+        const auto* attr = const_cast<Item*>(this)->getCustomAttribute("jvarmaid");
+        const auto* tag = attr ? boost::get<std::string>(&attr->value) : nullptr;
+        if (tag && tag->size() >= 3 && (*tag)[tag->size() - 2] == ':'
+            && tag->back() >= '1' && tag->back() <= '4') {
+            struct Visual { const char* chave; uint16_t base; uint16_t ids[4]; };
+            static const Visual visuais[] = {
+                {"espada", 2400, {7383, 7417, 7418, 2400}},
+                {"machado", 8925, {2431, 7412, 7434, 8925}},
+                {"martelo", 2421, {7422, 7437, 7415, 2421}},
+                {"arco", 8854, {2456, 7438, 8857, 8854}},
+                {"besta", 8851, {2455, 8849, 8850, 8851}},
+                {"cetro", 8922, {2188, 2189, 8921, 8922}},
+                {"bastao", 2183, {2186, 8911, 8912, 2183}},
+            };
+            const std::string chave = tag->substr(0, tag->size() - 2);
+            for (const auto& visual : visuais) {
+                if (visual.base == id && chave == visual.chave) {
+                    const uint16_t clientId = items[visual.ids[tag->back() - '1']].clientId;
+                    if (clientId != 0) { return clientId; }
+                    break;
+                }
+            }
+        }
+    }
+    return items[id].clientId;
+}
