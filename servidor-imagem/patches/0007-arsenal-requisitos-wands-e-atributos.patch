+ReturnValue Player::checkArsenalItem(const Item* item) const
+{
+	if (!item || !item->hasAttribute(ITEM_ATTRIBUTE_CUSTOM)) { return RETURNVALUE_NOERROR; }
+	// getCustomAttribute somente consulta atributos ja existentes (API antiga nao const).
+	Item* tagged = const_cast<Item*>(item);
+	if (!tagged->getCustomAttribute("jvarmaid")) { return RETURNVALUE_NOERROR; }
+	auto numero = [tagged](const char* key) -> int64_t {
+		const auto* attr = tagged->getCustomAttribute(key);
+		const auto* value = attr ? boost::get<int64_t>(&attr->value) : nullptr;
+		return value ? *value : -1;
+	};
+	const int64_t classe = numero("jvarmaclasse"), minimo = numero("jvarmalevel");
+	const int64_t evolucao = numero("jvarmaevolucao"), storage = numero("jvarmaevostorage");
+	if (classe < 1 || classe > 4 || minimo < 1 || evolucao < 1 || evolucao > 4 || storage < 1 || storage > 0xFFFFFFFFLL) {
+		return RETURNVALUE_CANNOTBEDRESSED;
+	}
+	if (vocation->getClientId() != classe) { return RETURNVALUE_YOUDONTHAVEREQUIREDPROFESSION; }
+	if (getLevel() < minimo) { return RETURNVALUE_NOTENOUGHLEVEL; }
+	int32_t atual = 0;
+	getStorageValue(static_cast<uint32_t>(storage), atual);
+	return atual >= evolucao ? RETURNVALUE_NOERROR : RETURNVALUE_CANNOTBEDRESSED;
 }
 
