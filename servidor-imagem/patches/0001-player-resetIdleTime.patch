+int LuaScriptInterface::luaPlayerResetIdleTime(lua_State* L)
+{
+	// player:resetIdleTime() -- JV Baiak: usado pelo treino automatico
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		player->resetIdleTime();
+		pushBoolean(L, true);
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
