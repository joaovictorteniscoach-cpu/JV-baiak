+void Player::scheduleEvolutionAttack()
+{
+	// Apenas intervalos explicitamente configurados; a base conserva o comportamento.
+	if (attackSpeed == 0 || evolutionAttackEvent != 0 || !getAttackedCreature()) {
+		return;
+	}
+	const uint32_t playerId = getID();
+	evolutionAttackEvent = g_scheduler.addEvent(createSchedulerTask(std::max<uint32_t>(200, getAttackSpeed()), [playerId]() {
+		Player* player = g_game.getPlayerByID(playerId);
+		if (!player) { return; }
+		player->evolutionAttackEvent = 0;
+		g_game.checkCreatureAttack(playerId);
+	}));
+}
+
 void Player::doAttacking(uint32_t)
 {
+	scheduleEvolutionAttack();
 	if (lastAttack == 0) {
 		lastAttack = OTSYS_TIME() - getAttackSpeed() - 1;
 	}
