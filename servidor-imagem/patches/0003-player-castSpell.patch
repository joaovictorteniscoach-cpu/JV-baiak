+int LuaScriptInterface::luaPlayerCastSpell(lua_State* L)
+{
+	// player:castSpell(words) -- JV Baiak: magia automatica (mesmas regras de quando o jogador fala:
+	// vocacao, level, mana, exaustao, alvo). Devolve true se a magia saiu.
+	Player* player = getUserdata<Player>(L, 1);
+	if (!player) {
+		lua_pushnil(L);
+		return 1;
+	}
+	std::string words = getString(L, 2);
+	std::string lowerWords = asLowerCaseString(words);
+	pushBoolean(L, g_spells->playerSaySpell(player, words, lowerWords) == TALKACTION_BREAK);
+	return 1;
+}
